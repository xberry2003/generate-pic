# Copy this file to:
# /www/wwwroot/text2image-workspace/backend/.env
#
# Fill real values on the server only. Do not commit real secrets.
# Important: save this file as UTF-8. The Chinese COS prefix must not become mojibake.

# Runtime
NODE_ENV=production
PORT=8000

# Database
# DATABASE_PATH is documented for humans/scripts.
# The FastAPI app reads DATABASE_URL.
DATABASE_PATH=/www/wwwroot/text2image-workspace/backend/data/app.db
DATABASE_URL=sqlite:////www/wwwroot/text2image-workspace/backend/data/app.db

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
AUTH_SECRET_KEY=change_me_random_session_secret
EMPLOYEE_DB_PATH=/www/wwwroot/auth-system/data/employees.db
# Comma-separated employee names that may manage gallery images.
ADMIN_EMPLOYEE_NAMES=谢茹羽,熊志杰,陈开铭

# MiniMax image generation
MINIMAX_API_BASE_URL=https://api.minimax.chat
MINIMAX_API_KEY=change_me_minimax_api_key
MINIMAX_MODEL=image-01
MINIMAX_IMAGE_ENDPOINT=/v1/image_generation
MINIMAX_RESPONSE_FORMAT=base64
MINIMAX_ASPECT_RATIO=1:1
MINIMAX_PROMPT_OPTIMIZER=true
MINIMAX_TIMEOUT_SECONDS=180
MINIMAX_SAVE_DIR=uploads/images

# Tencent COS
# TENCENT_* and COS_PREFIX are aliases for operator clarity.
# The current backend reads COS_SECRET_ID, COS_SECRET_KEY, and COS_KEY_PREFIX.
STORAGE_PROVIDER=cos
TENCENT_SECRET_ID=change_me_tencent_secret_id
TENCENT_SECRET_KEY=change_me_tencent_secret_key
COS_SECRET_ID=change_me_tencent_secret_id
COS_SECRET_KEY=change_me_tencent_secret_key
COS_BUCKET=change_me_cos_bucket
COS_REGION=ap-shanghai
COS_PREFIX=ppt-素材/图片素材/
COS_KEY_PREFIX=ppt-素材/图片素材/
COS_PUBLIC_BASE_URL=

# Legacy SFTP variables are not used when STORAGE_PROVIDER=cos.
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=
IMAGE_PUBLIC_BASE_URL=
