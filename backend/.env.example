# Database
DATABASE_URL=sqlite:///./generate_pic.db

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password
AUTH_SECRET_KEY=change_me_random_session_secret
EMPLOYEE_DB_PATH=/www/wwwroot/auth-system/data/employees.db

# MiniMax official image generation provider
MINIMAX_API_BASE_URL=https://api.minimax.chat
MINIMAX_API_KEY=
MINIMAX_MODEL=image-01
MINIMAX_IMAGE_ENDPOINT=/v1/image_generation
MINIMAX_RESPONSE_FORMAT=base64
MINIMAX_ASPECT_RATIO=16:9
MINIMAX_PROMPT_OPTIMIZER=true
MINIMAX_TIMEOUT_SECONDS=180
MINIMAX_SAVE_DIR=uploads/images

# KDocs AI product usage reporting
KDOCS_USAGE_EVENTS_ENABLED=true
KDOCS_USAGE_EVENTS_URL=https://43.142.31.198/kdocs-sync/api/products/usage-events
KDOCS_MINIMAX_PRODUCT_ID=73
KDOCS_USAGE_EVENTS_TIMEOUT_SECONDS=5
KDOCS_USAGE_EVENTS_VERIFY_SSL=false

# Remote image storage
STORAGE_PROVIDER=cos
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET=teachvideo-1311931714
COS_KEY_PREFIX=ppt-素材/图片素材
COS_PUBLIC_BASE_URL=
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSWORD=
SFTP_REMOTE_DIR=/data/ppt-素材/图片素材
IMAGE_PUBLIC_BASE_URL=
